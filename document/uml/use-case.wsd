@startuml UseCaseDiagram

left to right direction

actor "Admin" as Admin
actor "User" as User

rectangle "Sistema de Ventas" {
    usecase "Gestionar Personas" as UC1
    usecase "Gestionar Roles" as UC2
    usecase "Gestionar Usuarios" as UC3
    usecase "Gestionar Productos" as UC4
    usecase "Gestionar Inventario" as UC5
    usecase "Generar Facturas" as UC6
    usecase "Gestionar Detalles de Factura" as UC7
}

Admin --> UC1
Admin --> UC2
Admin --> UC3
Admin --> UC4
Admin --> UC5
Admin --> UC6
Admin --> UC7

User --> UC6
User --> UC7

@enduml